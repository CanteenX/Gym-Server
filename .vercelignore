# Keeps the upload small. Note this excludes files from the DEPLOYMENT, so
# anything server.js imports at runtime must NOT be listed here - Vercel's file
# tracing can only bundle what was uploaded. scripts/ is deliberately absent:
# server.js imports scripts/seedMenus.js, and ignoring it produced
# ERR_MODULE_NOT_FOUND on every request.
uploads/
log/
docs/
.github/
out/
.build/
test-email.js
precommit-output.txt

# Defense in depth. .env is committed to this repo (see CLAUDE.md), and the
# only thing keeping it unservable is outputDirectory pointing at a throwaway
# public/. Excluding it from the UPLOAD removes the dependency on routing
# behaviour entirely. Safe because every runtime value is set as a Vercel env
# var, and dotenv.config() does not override existing process.env values.
.env
.env.*
